# Server-side database connection (never exposed to the browser)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# TLS del pool de Postgres (opcional).
# Para verificar el certificado completo contra Supabase en producción:
#   DATABASE_SSL_MODE=verify-full
#   DATABASE_SSL_CA_FILE=./supabase-ca.pem   (ruta al certificado CA en PEM)
# Sin estas variables se mantiene el modo histórico (sin verificar emisor).
DATABASE_SSL_MODE=
DATABASE_SSL_CA_FILE=

# Semilla del administrador inicial (opcional).
# Si la tabla profiles está vacía se crea un admin con:
#   email:     admin@sistema.local
#   contraseña: la de esta variable (mínimo 8 chars) o, si está vacía,
#               una aleatoria que se imprime UNA sola vez en la consola del servidor.
#SEED_ADMIN_INITIAL_PASSWORD=

# Recuperación de contraseña sin proveedor de email (solo demo/desarrollo).
# En producción se recomienda integrar un proveedor de email y dejar esto vacío.
#RESET_LINK_ON_SCREEN=

# Supabase public config (optional, for migrating to Supabase — see supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Equivalent names if you port the frontend to Vite:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# NEVER expose SUPABASE_SERVICE_ROLE_KEY in client code or NEXT_PUBLIC_/VITE_ variables.
