    { key: "t", header: "Total", render: (s) => <div className="text-right font-medium">{formatMoney(s.total)}</div> },
    { key: "e2", header: "Estado", render: (s) => <Badge variant={s.estado === "entregado" ? "success" : s.estado === "cancelado" ? "danger" : "secondary"}>
